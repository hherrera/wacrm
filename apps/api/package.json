{
  "name": "@conexa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@conexa/shared": "*",
    "@fastify/cors": "11.3.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.13",
    "pg-boss": "12.38.0",
    "postgres": "3.4.9",
    "zod": "4.6.7",
    "@conexa/db": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "vitest": "^5.0.5"
  }
}
