{
  "name": "conexa",
  "version": "0.1.0",
  "private": true,
  "description": "Conexa — sistema de atención multicanal (fork de wacrm).",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev:web": "npm run dev -w @conexa/web",
    "dev:api": "npm run dev -w @conexa/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "ip-address": "^10.7.1",
    "fast-uri": "^3.1.8",
    "hono": "^4.13.5",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.17",
    "@babel/core": "^7.29.6",
    "sharp": "^0.35.5",
    "brace-expansion@^1.0.0": "^1.1.21",
    "brace-expansion@^5.0.0": "^5.0.12",
    "proxy-addr": "^2.0.8",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "undici": "^7.29.1",
    "source-map-js": "^1.2.2"
  }
}
